    }

    if (!dma350_ch_is_init(dev))
    {
        ch_err = dma350_ch_init(dev);

        if (ch_err != DMA350_CH_ERR_NONE)
        {
            return DMA350_LIB_ERR_CHANNEL_INVALID;
        }
    }

    return DMA350_LIB_ERR_NONE;
}

